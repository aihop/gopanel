{
	"name": "gopanel",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"build": "run-p type-check \"build:only {@}\" --",
		"build:only": "vite build --mode prod",
		"build:public": "vite build --mode prod --outDir ../public --emptyOutDir",
		"build:analyzer": "vite-bundle-visualizer -t sunburst",
		"build:check": "run-s libs:reload build lint type-check format test:unit",
		"preview": "vite build && echo '' && vite preview --port 4173 --host",
		"preview:only": "vite preview --port 4173 --host",
		"test:unit": "vitest run",
		"type-check": "vue-tsc --build --force",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"lint-format": "run-s lint type-check format",
		"tailwind-config-viewer": "tailwind-config-viewer -o",
		"design-tokens": "node scripts/tokens-tool.js",
		"libs:check": "taze",
		"libs:reload": "rm -rf node_modules package-lock.json && npm install"
	},
	"dependencies": {
		"@guolao/vue-monaco-editor": "^1.5.5",
		"@tailwindcss/container-queries": "^0.1.1",
		"@vueuse/components": "^13.9.0",
		"@vueuse/core": "^13.9.0",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"axios": "^1.15.0",
		"colord": "^2.9.3",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.13",
		"detect-touch-device": "^1.1.6",
		"lodash": "^4.17.21",
		"md-editor-v3": "^6.4.2",
		"mitt": "^3.0.1",
		"naive-ui": "^2.41.0",
		"pinia": "^3.0.1",
		"pinia-plugin-persistedstate": "^4.5.0",
		"validator": "^13.12.0",
		"vite-plugin-monaco-editor": "^1.1.0",
		"vue": "^3.5.13",
		"vue-advanced-cropper": "^2.8.9",
		"vue-clipboard3": "^2.0.0",
		"vue-hooks-plus": "^2.2.3",
		"vue-i18n": "^11.1.1",
		"vue-router": "^4.5.0",
		"xterm": "^5.3.0",
		"xterm-addon-fit": "^0.8.0"
	},
	"optionalDependencies": {
		"treemate": "^0.3.11",
		"vueuc": "^0.4.64"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.2.0",
		"@clack/prompts": "^0.10.0",
		"@eslint/js": "^9.22.0",
		"@faker-js/faker": "^9.6.0",
		"@iconify/vue": "^4.3.0",
		"@tsconfig/node20": "^20.1.4",
		"@types/dom-view-transitions": "^1.0.5",
		"@types/fs-extra": "^11.0.4",
		"@types/inquirer": "^9.0.7",
		"@types/jsdom": "^21.1.7",
		"@types/lodash": "^4.17.15",
		"@types/node": "^22.13.4",
		"@types/validator": "^13.12.2",
		"@typescript-eslint/parser": "^8.26.1",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitejs/plugin-vue-jsx": "^4.1.1",
		"@vue-hooks-plus/resolvers": "^1.2.5",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.7.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.20.1",
		"eslint-plugin-vue": "^10.0.0",
		"fs-extra": "^11.3.0",
		"globals": "^15.15.0",
		"jsdom": "^26.0.0",
		"npm-run-all2": "^7.0.2",
		"postcss": "^8.5.2",
		"prettier": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"rollup-plugin-visualizer": "^6.0.11",
		"sass": "^1.85.0",
		"tailwind-config-viewer": "^2.0.4",
		"tailwindcss": "^3.4.17",
		"taze": "^18.5.0",
		"ts-node": "^10.9.2",
		"type-fest": "^4.34.1",
		"typescript": "~5.7.3",
		"unplugin-auto-import": "^19.1.1",
		"unplugin-vue-components": "^28.0.0",
		"vite": "^6.1.0",
		"vite-bundle-visualizer": "^1.2.1",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-vue-devtools": "^7.7.2",
		"vite-svg-loader": "^5.1.0",
		"vitest": "^3.0.5",
		"vue-tsc": "^2.2.0"
	},
	"resolutions": {
		"@typescript-eslint/typescript-estree": "^8.24.0"
	}
}
